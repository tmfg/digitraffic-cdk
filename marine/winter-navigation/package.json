{
  "name": "winter-navigation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "heft build --clean && npm run build:bundle",
    "build:bundle": "npm run compile-lambdas",
    "build:tsc": "heft build --clean",
    "build:watch": "heft build-watch --clean",
    "cdk": "cdk",
    "cdk-deploy-marine-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh marine-prod deploy WinterNavigationProd",
    "cdk-deploy-marine-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh marine-test deploy WinterNavigationTest",
    "cdk-diff-marine-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh marine-prod diff WinterNavigationProd",
    "cdk-diff-marine-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh marine-test diff WinterNavigationTest",
    "ci:test": "vitest run --reporter=junit --outputFile=test-results.xml",
    "compile-canaries": "esbuild src/canaries/*.ts --log-level=warning --bundle --platform=node --outdir=dist/nodejs/node_modules --external:Synthetics --target=node22,es2020",
    "compile-lambdas": "node lib/esbuild.js",
    "compile-lambdas-old": "esbuild src/lambda/**/*.ts --log-level=warning --bundle --platform=node --outdir=dist/lambda --target=node22,es2022",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@digitraffic/common": "2026.11.13-1",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "es-toolkit": "1.53.2",
    "ky": "2.2.0",
    "pg-native": "3.9.1",
    "pg-promise": "12.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@digitraffic-cdk/cdk-rig": "workspace:*",
    "@digitraffic-cdk/esbuild": "workspace:*",
    "@digitraffic-cdk/testing": "workspace:*",
    "@digitraffic-cdk/toolchain": "workspace:*",
    "@rushstack/heft": "1.3.5",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "4.1.12",
    "aws-cdk": "2.1148.0",
    "date-fns": "4.4.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
