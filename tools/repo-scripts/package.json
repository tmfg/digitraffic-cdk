{
  "name": "@digitraffic-cdk/repo-scripts",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:clean && npm run bundle",
    "build:clean": "heft build --clean",
    "build:watch": "heft build-watch --clean",
    "bundle": "rollup -c",
    "ci:test": "echo 'No tests implemented'",
    "publish:cdk": "npm run bundle && cp dist/*.mjs ../../common/scripts/",
    "test": "echo 'No tests implemented'"
  },
  "dependencies": {
    "@digitraffic/common": "workspace:*",
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "es-toolkit": "1.53.0",
    "fs-extra": "11.4.1",
    "globby": "16.2.4",
    "zx": "8.8.5"
  },
  "devDependencies": {
    "@digitraffic-cdk/cdk-rig": "workspace:*",
    "@digitraffic-cdk/toolchain": "workspace:*",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@rushstack/heft": "1.3.4",
    "@types/async": "3.2.26",
    "@types/fs-extra": "11.0.4",
    "@types/node": "24.12.2",
    "async": "3.2.6",
    "rollup": "4.66.0",
    "typescript": "5.9.3"
  }
}
