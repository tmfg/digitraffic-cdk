{
  "name": "maintenance-tracking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "heft build --clean && npm run build:bundle",
    "build:bundle": "npm run compile-lambdas",
    "build:bundle_": "npm run compile-lambdas && npm run compile-canaries",
    "build:tsc": "heft build --clean",
    "build:watch": "heft build-watch --clean",
    "cdk": "cdk",
    "cdk-deploy-road-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh road-prod deploy",
    "cdk-deploy-road-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh road-test deploy",
    "cdk-diff-road-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh road-prod diff",
    "cdk-diff-road-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh road-test diff",
    "ci:test": "vitest run --reporter=junit --outputFile=test-results.xml",
    "compile-canaries": "esbuild src/canaries/*.ts --log-level=warning --bundle --platform=node --outdir=dist/nodejs/node_modules --external:Synthetics --target=node22,es2020",
    "compile-lambdas": "node lib/esbuild.js",
    "compile-lambdas-old": "esbuild src/lambda/**/*.ts --log-level=warning --bundle --platform=node --outdir=dist/lambda --target=node22,es2022",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/client-sqs": "3.1160.0",
    "@digitraffic/common": "2026.10.23-1",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "date-fns": "4.4.0",
    "dtsgenerator": "3.19.2",
    "es-toolkit": "1.53.0",
    "pg-native": "3.9.1",
    "pg-promise": "12.7.1",
    "spex": "4.1.0",
    "sqs-extended-client": "1.0.0"
  },
  "devDependencies": {
    "@digitraffic-cdk/cdk-rig": "workspace:*",
    "@digitraffic-cdk/esbuild": "workspace:*",
    "@digitraffic-cdk/testing": "workspace:*",
    "@digitraffic-cdk/toolchain": "workspace:*",
    "@rushstack/heft": "1.3.4",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.12.2",
    "@types/sinon": "22.0.2",
    "@vitest/coverage-v8": "4.1.12",
    "aws-cdk": "2.1146.1",
    "esbuild": "0.28.2",
    "parallelshell": "3.2.1",
    "sinon": "22.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
