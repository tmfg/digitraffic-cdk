{
  "name": "yearly-plans",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "heft build --clean && npm run build:bundle",
    "build:bundle": "npm run compile-lambdas",
    "build:tsc": "heft build --clean",
    "build:watch": "heft build-watch --clean",
    "cdk": "cdk",
    "cdk-deploy-rail-prod": "../../scripts/cdk-diff-and-deploy.sh rail-prod deploy YearlyPlansProd",
    "cdk-deploy-rail-test": "../../scripts/cdk-diff-and-deploy.sh rail-test deploy YearlyPlansTest",
    "cdk-diff-rail-prod": "../../scripts/cdk-diff-and-deploy.sh rail-prod diff YearlyPlansProd",
    "cdk-diff-rail-test": "../../scripts/cdk-diff-and-deploy.sh rail-test diff YearlyPlansTest",
    "ci:test": "vitest run --reporter=junit --outputFile=test-results.xml",
    "compile-lambdas": "node lib/esbuild.js",
    "compile-lambdas-old": "esbuild src/lambda/**/*.ts --log-level=warning --bundle --platform=node --outdir=dist/lambda/update-plans --target=node22,es2022",
    "convert-schema": "node src/scripts/schema-fix.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@digitraffic/common": "2026.11.13-1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "archiver": "8.0.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "ky": "2.2.0"
  },
  "devDependencies": {
    "@digitraffic-cdk/cdk-rig": "workspace:*",
    "@digitraffic-cdk/esbuild": "workspace:*",
    "@digitraffic-cdk/testing": "workspace:*",
    "@digitraffic-cdk/toolchain": "workspace:*",
    "@rushstack/heft": "1.3.5",
    "@types/archiver": "8.0.0",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "4.1.12",
    "aws-cdk": "2.1148.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
