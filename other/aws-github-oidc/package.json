{
  "name": "aws-github-oidc",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "cdk-deploy-afir-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh afir-prod deploy AwsGithubOidcAfirProd",
    "cdk-deploy-afir-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh afir-test deploy AwsGithubOidcAfirTest",
    "cdk-deploy-catalog-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh catalog-prod deploy AwsGithubOidcCatalogProd",
    "cdk-deploy-catalog-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh catalog-test deploy AwsGithubOidcCatalogTest",
    "cdk-deploy-marine-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh marine-prod deploy AwsGithubOidcMarineProd",
    "cdk-deploy-marine-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh marine-test deploy AwsGithubOidcMarineTest",
    "cdk-deploy-parking-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh parking-prod deploy AwsGithubOidcParkingProd",
    "cdk-deploy-parking-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh parking-test deploy AwsGithubOidcParkingTest",
    "cdk-deploy-rail-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh rail-prod deploy AwsGithubOidcRailProd",
    "cdk-deploy-rail-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh rail-test deploy AwsGithubOidcRailTest",
    "cdk-deploy-road-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh road-prod deploy AwsGithubOidcRoadProd",
    "cdk-deploy-road-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh road-test deploy AwsGithubOidcRoadTest",
    "cdk-deploy-status-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh status-prod deploy AwsGithubOidcStatusProd",
    "cdk-deploy-status-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh status-test deploy AwsGithubOidcStatusTest",
    "cdk-diff-afir-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh afir-prod diff AwsGithubOidcAfirProd",
    "cdk-diff-afir-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh afir-test diff AwsGithubOidcAfirTest",
    "cdk-diff-catalog-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh catalog-prod diff AwsGithubOidcCatalogProd",
    "cdk-diff-catalog-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh catalog-test diff AwsGithubOidcCatalogTest",
    "cdk-diff-marine-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh marine-prod diff AwsGithubOidcMarineProd",
    "cdk-diff-marine-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh marine-test diff AwsGithubOidcMarineTest",
    "cdk-diff-parking-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh parking-prod diff AwsGithubOidcParkingProd",
    "cdk-diff-parking-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh parking-test diff AwsGithubOidcParkingTest",
    "cdk-diff-rail-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh rail-prod diff AwsGithubOidcRailProd",
    "cdk-diff-rail-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh rail-test diff AwsGithubOidcRailTest",
    "cdk-diff-road-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh road-prod diff AwsGithubOidcRoadProd",
    "cdk-diff-road-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh road-test diff AwsGithubOidcRoadTest",
    "cdk-diff-status-prod": "rushx build && ../../scripts/cdk-diff-and-deploy.sh status-prod diff AwsGithubOidcStatusProd",
    "cdk-diff-status-test": "rushx build && ../../scripts/cdk-diff-and-deploy.sh status-test diff AwsGithubOidcStatusTest",
    "ci:test": "vitest run --reporter=junit --outputFile=test-results.xml",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@digitraffic/common": "2026.10.23-1",
    "aws-cdk-lib": "2.262.2",
    "constructs": "10.7.2",
    "source-map-support": "0.5.21"
  },
  "devDependencies": {
    "@digitraffic-cdk/cdk-rig": "workspace:*",
    "@digitraffic-cdk/esbuild": "workspace:*",
    "@digitraffic-cdk/testing": "workspace:*",
    "@digitraffic-cdk/toolchain": "workspace:*",
    "@rushstack/heft": "1.2.22",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "4.1.12",
    "aws-cdk": "2.1134.0",
    "esbuild": "0.28.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
